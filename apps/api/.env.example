DATABASE_URL=postgres://knife:knife@localhost:5433/knife
PORT=3000
LINTERS_URL=http://localhost:8081
# Where this server answers from: what Google redirects back to, and the
# address an agent's pass is made out to.
PUBLIC_URL=http://localhost:3000
# Where a person's browser goes after signing in.
WEB_URL=http://localhost:5173

# Signs the session cookie. Without it everyone signs in again on restart.
SESSION_SECRET=

# From Google Cloud Console, OAuth client of type "Web application", with
# PUBLIC_URL + /api/auth/google/callback as an authorised redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
