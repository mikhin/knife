// Text still lives in two tables, and nothing derived from it is ever written
// back: duplicates, occurrences, links and linter findings are computed on
// demand, because a stored verdict would outlive the wording it judged.
//
// The rest of the tables hold no text at all. They answer one question the
// universe cannot answer for itself — whose it is — and they exist only
// because the door was opened to other people and to agents.

// The client is generated as CommonJS because the API is compiled as one:
// the ESM client reaches for import.meta.url, which survives neither the
// compile to CJS nor the Node that loads the result.
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// A person, known by the address Google vouched for. Nothing else about
/// them is kept: no name, no picture, nothing that would have to be
/// forgotten later.
model User {
  id        String    @id @default(uuid()) @db.Uuid
  email     String    @unique
  googleSub String?   @unique @map("google_sub")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  projects  Project[]

  @@map("users")
}

model Project {
  id        String          @id @default(uuid()) @db.Uuid
  ownerId   String          @map("owner_id") @db.Uuid
  name      String
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  access    ProjectAccess[]
  chunks    Chunk[]
  owner     User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, name])
  @@index([ownerId])
  @@map("projects")
}

/// One guest of one project, named by address rather than by account: an
/// invitation to somebody who has never signed in is the same row as the
/// access they get afterwards. Nothing is mailed and nothing has to be
/// claimed — signing in with that address is the claim.
///
/// A guest works inside the universe: reads it, adds to it, deletes from it.
/// Renaming the project, deleting it and deciding who else comes in stay
/// with the owner, because those are decisions about the folder rather than
/// about the text in it.
model ProjectAccess {
  projectId String   @map("project_id") @db.Uuid
  email     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, email])
  @@index([email])
  @@map("project_access")
}

model Chunk {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  text      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("chunks")
}

/// An agent's client, registered by the agent itself the first time it knocks.
/// Nobody types these in by hand, which is the point: a person adds the server
/// by its address and never copies a secret anywhere.
model OAuthClient {
  id           String   @id @map("client_id")
  secretHash   String?  @map("secret_hash")
  name         String
  redirectUris String[] @map("redirect_uris")
  scopes       String[]
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("oauth_clients")
}

/// Lives for a minute between the browser and the agent, and is stored hashed:
/// the row is worthless to anyone who reads the table.
model OAuthCode {
  codeHash      String   @id @map("code_hash")
  clientId      String   @map("client_id")
  memberId      String   @map("member_id") @db.Uuid
  scopes        String[]
  codeChallenge String   @map("code_challenge")
  redirectUri   String   @map("redirect_uri")
  resource      String?
  expiresAt     DateTime @map("expires_at") @db.Timestamptz(6)

  @@index([expiresAt])
  @@map("oauth_codes")
}

/// Opaque rather than self-describing, so revoking one is immediate: the token
/// is worth nothing except as a row here, and deleting the row ends it.
model OAuthToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @map("token_hash")
  kind      TokenKind
  clientId  String    @map("client_id")
  memberId  String    @map("member_id") @db.Uuid
  scopes    String[]
  resource  String?
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([memberId])
  @@index([expiresAt])
  @@map("oauth_tokens")
}

enum TokenKind {
  ACCESS
  REFRESH
}
